# Copia in .env (cp .env.example .env). Il Makefile lo carica in automatico.
# Formato KEY=valore, senza virgolette né spazi attorno a "=".

DATABASE_URL=postgres://queuedesk:queuedesk@localhost:55432/queuedesk?sslmode=disable
HTTP_ADDR=:8080
SESSION_TTL=24h
SHUTDOWN_TIMEOUT=10s
NOTIFY_WORKERS=4
NOTIFY_QUEUE_SIZE=64

# Usate da `make seed` e da scripts/smoke.sh (solo per la demo locale).
SEED_AGENT_EMAIL=agent@queuedesk.local
SEED_AGENT_PASSWORD=agent-demo-password
